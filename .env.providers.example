# ═══ Key + endpoint của provider ═══
#
# CHỈ service `litellm` đọc file này (`env_file` trong docker-compose.yml).
# Backend KHÔNG đọc — xem chú thích "Provider keys" trong
# `backend/app/config/settings.py` và NQ-15.
#
# Nhờ vậy thêm một provider mới = thêm vài dòng ở đây + 1 entry trong
# `config/litellm.config.yaml` + 1 entry trong `config/model_catalog.json`.
# KHÔNG dòng `.py`, KHÔNG dòng `docker-compose.yml` — đúng tiêu chí S15.
#
# Thủ tục đầy đủ: `docs/RUNBOOK-them-provider.md`.
#
# ⚠ Trái với `.env`, thiếu một biến ở đây KHÔNG làm app dừng lúc boot: LiteLLM
# chỉ báo lỗi lúc gọi model. Bước 5 của RUNBOOK (gọi thử) là chỗ duy nhất bắt
# được sai sót đó — đừng bỏ.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 9Router chạy NGOÀI Docker trên Windows host (§9.5, C17) — `localhost` trong
# container là chính container đó, nên phải dùng `host.docker.internal`.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
# Để rỗng nếu 9Router không yêu cầu key. Chú thích phải nằm trên DÒNG RIÊNG:
# `VAR=` + khoảng trắng + `# ...` làm docker compose lấy nguyên chuỗi chú thích
# làm giá trị (xem B-44, họ hàng của B-31).
NINEROUTER_API_KEY=

# Ollama self-host trong compose (T-0.12) — base_url là TÊN SERVICE, không phải
# `localhost` và cũng không phải `host.docker.internal` (C45).
# Ollama không xác thực; SDK OpenAI vẫn đòi một chuỗi khác rỗng nên đặt tạm.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
