# LUẬT CỦA FILE NÀY — KHÔNG chú thích ở cuối dòng gán (B-44, B-118, NQ-45).
#
# `KEY=<rỗng>   # ghi chú` cho ra GIÁ TRỊ là nguyên câu ghi chú, không phải
# chuỗi rỗng: docker compose chỉ bóc `#` khi phía trước nó đã có giá trị. Đo
# được 2026-09-17: `TURNSTILE_SECRET` trong container `api` dài 52 ký tự và
# bắt đầu bằng `#` — tức nhánh `if settings.TURNSTILE_SECRET:` tin rằng đã có
# secret, còn cảnh báo lúc boot thì không bao giờ chạy.
#
# Chú thích luôn đặt ở DÒNG RIÊNG phía trên. `tests/test_env_file_format.py`
# canh luật này cho cả `.env.example` lẫn `.env`, và `Settings` từ chối boot
# khi một biến có giá trị bắt đầu bằng `#`.

# ═══ BẮT BUỘC — thiếu bất kỳ dòng nào, app KHÔNG boot (S1) ═══
DATABASE_URL=postgresql+asyncpg://scarlet:CHANGE_ME@postgres:5432/scarlet
# chỉ docker compose đọc (NQ-08) — phải TRÙNG mật khẩu trong DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32  — mã hoá BYOK
MASTER_ENCRYPTION_KEY=
# cũng đặt trong litellm.config.yaml
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://litellm:4000/v1
PUBLIC_BASE_URL=https://localhost
ARTIFACTS_BASE_URL=https://artifacts.localhost

# ═══ Frontend (Vite, T-0.10) — có default hợp lý, không bắt buộc ═══
VITE_API_BASE_URL=/api/v1

# ═══ Test tầng DB (pytest, T-1.1) — CHỈ pytest đọc, backend KHÔNG đọc ═══
# Database RIÊNG trên cùng instance `postgres`; tests/db/conftest.py tự tạo nếu
# chưa có rồi chạy `alembic upgrade head`. Không đụng database `scarlet` của dev.
# Host là 127.0.0.1 (cổng do docker-compose.override.yml publish ra loopback),
# KHÔNG phải `postgres` — pytest chạy từ host, ngoài network `internal`.
# Mật khẩu phải TRÙNG POSTGRES_PASSWORD.
TEST_DATABASE_URL=postgresql+asyncpg://scarlet:CHANGE_ME@127.0.0.1:5432/scarlet_test

# ═══ scripts/test_resume.py (T-1.11) — CHỈ script đọc, backend KHÔNG đọc ═══
# Cùng instance `postgres` nhưng qua cổng loopback mà `docker-compose.override.yml`
# publish, và trỏ vào database `scarlet` CỦA DEV — không phải `scarlet_test`:
# script so `messages.content` mà `api`/`worker` vừa ghi thật. Hột `postgres:5432`
# trong DATABASE_URL chỉ phân giải được BÊN TRONG network `internal`, mà script
# chạy ở WSL host. Mật khẩu phải TRÙNG POSTGRES_PASSWORD.
DEV_DATABASE_URL=postgresql+asyncpg://scarlet:CHANGE_ME@127.0.0.1:5432/scarlet

# ═══ scripts/bench_ttft.py (T-1.12) — CHỈ script đọc, backend KHÔNG đọc ═══
# Cùng lý do tồn tại như DEV_DATABASE_URL, khác dịch vụ: LITELLM_BASE_URL ghi
# `litellm:4000`, một tên chỉ phân giải được BÊN TRONG network `internal`, còn
# đường "baseline" của bench chạy ở WSL host nên phải đi qua cổng mà
# docker-compose.yml publish. Chỉ dùng để đo, KHÔNG phải đường app gọi model.
DEV_LITELLM_BASE_URL=http://localhost:4000/v1

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=scarlet

# ═══ Provider keys — ĐÃ CHUYỂN sang .env.providers (NQ-09, T-0.12) ═══
# Xem `.env.providers.example`. Chỉ service `litellm` đọc file đó; backend
# không đọc, nên thêm provider mới KHÔNG phải sửa file này (S15).

# ═══ Email ═══
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Scarlet <no-reply@scarlet.local>
# Tran cho MOT lan goi smtplib.SMTP (connect+login+send), chay trong
# asyncio.to_thread (core/mailer.py, T-2.2).
SMTP_TIMEOUT_S=10

# ═══ Đăng ký & bảo mật ═══
# open | approval | invite
REGISTRATION_MODE=approval
# Khoá CÔNG KHAI của widget. docker-compose.yml ánh xạ chính biến này sang
# VITE_TURNSTILE_SITE_KEY cho service `web` — một nguồn sự thật, không có
# biến VITE_ thứ hai để lệch.
TURNSTILE_SITE_KEY=
# rỗng = bỏ qua (chỉ dev), log cảnh báo mỗi lần boot ở CẢ register lẫn
# forgot-password (§11.6, T-2.6). Lấy ở dashboard Cloudflare Turnstile.
# Khoá thử của Cloudflare, dùng được khi dev: 1x000…AA luôn ĐẠT,
# 2x000…AA luôn TRƯỢT (34 ký tự, tiền tố 0x là khoá thật).
TURNSTILE_SECRET=
# Endpoint siteverify. Ở đây chứ không phải hằng trong .py: A3/§19.2 L1 cấm
# literal URL provider trong code.
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Trần thời gian MỘT lần gọi siteverify. Biến riêng với FETCH_TIMEOUT_S:
# hai chặng mạng khác nhau tới hai bên khác nhau.
TURNSTILE_TIMEOUT_S=10
EMAIL_TOKEN_TTL_MIN=60
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_TIME_COST=3
# 192 MiB - do that ~108-126ms tren may dev (DoD T-2.1: 50-200ms). Xem chu
# thich o Settings.ARGON2_MEMORY_KIB cho cac muc da thu.
ARGON2_MEMORY_KIB=196608
PASSWORD_MIN_LENGTH=12
# Nguong diem zxcvbn (0-4) de coi mat khau la "qua pho bien" (SS11.6, T-2.1).
PASSWORD_MIN_ZXCVBN_SCORE=2
# Rate limit THEO IP (SS10.6, lop thu ba cua bang) - KHAC quota (gioi han tien).
# Route gui thu cho mot email nguoi goi tu nhap: forgot-password,
# resend-verification. Cua so la 1 GIO, nam trong ten bien (app/core/ratelimit.py).
RATE_LIMIT_EMAIL_IP_PER_HOUR=3
# Route /auth/* KHONG gui thu: logout, reset-password. Con so lay tu nhom `auth`
# cua SS10.6 (5/phut), doi truc dem tu user sang IP vi chua co user de dem theo.
RATE_LIMIT_AUTH_IP_PER_MIN=5
# Rate limit THEO USER, nhom route `chat` (SS10.6, lop thu hai cua bang) -
# token bucket + Lua atomic trong Redis (T-2.9). Vua la suc chua cua xo, vua
# la toc do nap lai: 20 token, nap day lai trong 60 s. Cua so 60 s nam trong
# ten bien (app/core/ratelimit.py). Nhom `auth` cua cung hang do dung truc IP
# o bien ngay tren (NQ-43); nhom `upload` cho toi Phase 4 (B-148).
RATE_LIMIT_CHAT_PER_MIN=20

# ═══ API (§18.2) ═══
# Số hội thoại tối đa một trang của `GET /conversations`: vừa là mặc định, vừa là
# trần cho `?limit=`. Phân trang bằng con trỏ `updated_at`, không phải OFFSET.
CONVERSATION_PAGE_SIZE=30
# T-S.8 - tran cua `GET /conversations?pinned=true`: moi hoi thoai ghim trong MOT
# response, khong con tro. Vuot tran => tra dung ngan nay hang kem `truncated: true`.
CONVERSATION_PINNED_MAX=100
# So dong toi da mot trang cua `GET /admin/audit-logs` (SS16.3): vua la mac dinh,
# vua la tran cho `?limit=`. Phan trang bang con tro `id` (BIGSERIAL), khong phai
# OFFSET va cung khong phai `created_at` - hai dong ghi trong cung mot transaction
# mang cung mot `now()`.
AUDIT_LOG_PAGE_SIZE=50
# T-3.12 / B-192 - so giay `GET /admin/system` dung lai ket qua healthcheck
# (nam luot di mang, 9Router ~850 ms). Man "He thong" ghi "Kiem luc ..." theo
# moc server tra ve. `GET /health/deep` KHONG doc bien nay - may hoi thi do tuoi.
ADMIN_HEALTH_CACHE_TTL_S=10
# T-3.12 / B-175 - tran do dai cua so cua `GET /admin/usage`, tinh bang ngay.
# Vuot tran => 400. Tran chu khong phan trang: bao cao la tong hop.
ADMIN_USAGE_MAX_WINDOW_DAYS=92
# Tuổi thọ bản ghi chống trùng `idem:{user_id}:{route}:{key}` của §11.4, dùng cho
# cả `in_progress` lẫn `done`. 24 giờ là con số ADR-15 viết ra.
IDEMPOTENCY_TTL_S=86400

# ═══ Streaming (§7) ═══
STREAM_TTL_S=3600
STREAM_HEARTBEAT_S=15
# Nhịp worker ghi `messages.heartbeat_at` (§7.6). Tỉ lệ
# REAPER_STALE_S / WORKER_HEARTBEAT_S = số nhịp được phép lỡ (90/15 = 6).
WORKER_HEARTBEAT_S=15
REAPER_STALE_S=90
REAPER_QUEUED_STALE_S=1200
# Nhịp worker ghi khoá `arq:queue:health-check` mà `arq --check` (healthcheck
# của service worker) đọc; mặc định của arq là 3600 s nên phải đặt. Biến RIÊNG
# với WORKER_HEARTBEAT_S từ T-1.10 — xem B-74/NQ-27.
WORKER_HEALTHCHECK_S=15
# B-196 — vong noi lai cua `app/workers/run.py`. Mot lan Redis khoi dong
# lai la du giet vong lap chinh cua arq, ma tien trinh KHONG thoat (no treo
# trong `close()`), nen `restart: unless-stopped` khong cuu duoc. Ba bien:
#   BACKOFF_S     = cho bao lau truoc lan dung lai DAU TIEN
#   BACKOFF_MAX_S = tran khi nhan doi, cung la moc de coi mot su co la MOI
#   SHUTDOWN_TIMEOUT_S = tran cho luot dong worker cu (no di qua Redis,
#                        tuc dung thu vua chet — khong kep thi treo o day)
WORKER_RECONNECT_BACKOFF_S=1.0
WORKER_RECONNECT_BACKOFF_MAX_S=30.0
WORKER_SHUTDOWN_TIMEOUT_S=10.0
ARQ_POLL_DELAY_S=0.1
MAX_CONCURRENT_STREAMS=3
# Tuổi thọ cờ huỷ `cancel:{message_id}` của §7.5 (`SET ... EX 300`). Chỉ cần
# lớn hơn khoảng cách từ lúc bấm Dừng tới chunk tiếp theo worker đọc; rộng thế
# này để phủ cả ca message còn `queued` mà worker chưa nhận job.
CANCEL_TTL_S=300

# ═══ Worker & hàng đợi (ADR-02, §5.2) ═══
# Trần thời gian một job `generate`. Phải > LLM_REQUEST_TIMEOUT_S: timeout của
# tầng HTTP phải nổ trước, nếu không arq huỷ job giữa lúc model đang sinh —
# tiền vẫn mất mà không ai ghi được kết quả.
GENERATE_TIMEOUT_S=900

# ═══ Quota (§10) ═══
# 5 giờ
QUOTA_WINDOW_SHORT_S=18000
# 7 ngày
QUOTA_WINDOW_LONG_S=604800
DAILY_ALERT_USD=2.00
MONTHLY_BUDGET_USD=30.00
# Cache han muc tier trong Redis (§10.4). 60 s la AC cua UC-07: doi han muc
# trong admin panel phai co hieu luc trong ngan ay giay, khong restart.
TIER_CACHE_TTL_S=60
# Nguong canh bao "sap het quota" (UC-07 dong 1: con <= 20% thi hien thanh
# canh bao, KHONG chan). Don vi: phan tram con lai.
QUOTA_WARN_REMAINING_PCT=20

# ═══ Provider layer (§9.1) ═══
# Timeout chặng backend → LiteLLM. Phải ≥ `request_timeout` trong
# config/litellm.config.yaml, nếu không backend cắt trước mà LiteLLM vẫn sinh
# tiếp — vẫn tính tiền nhưng không ai đọc.
LLM_REQUEST_TIMEOUT_S=600
# temperature gửi cho model. 1.0 = mặc định của Chat Completions, tức backend
# không áp ý kiến riêng. Tuỳ chọn theo từng người dùng là user_settings (§18.4).
LLM_TEMPERATURE=1.0
# Trần thời gian MỘT lần kiểm khoá BYOK còn sống (§10.5, T-2.14). Biến riêng
# với LLM_REQUEST_TIMEOUT_S: đó là trần của một lượt sinh chữ, còn ở đây người
# dùng đang ngồi nhìn nút "Lưu khoá" quay.
BYOK_VERIFY_TIMEOUT_S=10
# Endpoint BYOK nguoi dung tu nhap (T-S.19b, NQ-134): tran so endpoint moi
# nguoi, so model moi endpoint, do dai ten endpoint / ten model.
BYOK_ENDPOINTS_MAX_PER_USER=5
BYOK_ENDPOINT_MODELS_MAX=50
BYOK_ENDPOINT_NAME_MAX_CHARS=128
# Model tu nhap khong co trong catalog: hai so nay thay context_window /
# max_output cho ngan sach §9.6.
BYOK_ENDPOINT_CONTEXT_WINDOW=64000
BYOK_ENDPOINT_MAX_OUTPUT=4096
# T-S.4 / NQ-113 - nhip do nen cac provider `host-dependent` (9Router) trong `api`,
# cung la tuoi ma FE coi `checked_at` cua GET /models la cu (`stale_after_s`).
# Request KHONG BAO GIO cho mot luot do. Moi tien trinh `api` do rieng.
PROVIDER_HEALTH_TTL_S=30
# Tran cho MOT luot do, va la tran `api` cho luot do dau luc khoi dong.
PROVIDER_PROBE_TIMEOUT_S=5.0

# ═══ Context & vision (§9.6, §15.3) ═══
# Tran do dai MOT message nguoi dung gui len, tinh bang KY TU (B-205, NQ-78).
# Ap o bien vao cho ca POST /conversations/{id}/messages lan PATCH
# /messages/{id}; FE doc lai chinh con so nay qua GET /auth/me, khong tu dat
# tran rieng. Phai nam DUOI ngan sach token nho nhat cua catalog (hom nay
# ol-qwen-small = 27672 token theo §9.6) de no la cua chan DAU TIEN — neu
# khong thi mot lan dan qua dai lai no o llm/context.py giua luot sinh.
MESSAGE_MAX_CHARS=24000
# T-S.5 - tran do dai ten hien thi (users.display_name), tinh bang KY TU. Ap o
# bien vao cua PUT /settings; FE doc lai qua GET /auth/me (display_name_max_chars).
DISPLAY_NAME_MAX_CHARS=64
# T-S.7 - tran dau vao cua luot dat ten hoi thoai tu dong, tinh bang KY TU: chi
# ngan nay ky tu dau cua cau hoi dau tien vao prompt cua `title_model`
# (config/prompts/title.jinja). Luot dat ten di bang system key, KHONG tru quota.
TITLE_INPUT_MAX_CHARS=2000
CONTEXT_WINDOW_CAP=128000
RESERVE_TOKENS=1000
VISION_MAX_EDGE_PX=1568
VISION_MAX_BYTES=3500000
MAX_PDF_PAGES_VISION=10
# C33 — bật lên là hoá đơn tăng vọt
RESEND_IMAGES_IN_HISTORY=false

# ═══ Web tools (§12) ═══
TAVILY_API_KEY=
FETCHER_BASE_URL=http://fetcher:8080
MAX_FETCH_MB=5
MAX_REDIRECTS=5
JS_ESCALATE_MIN_CHARS=200
FETCH_TIMEOUT_S=10
PLAYWRIGHT_TIMEOUT_S=20

# ═══ Sandbox (§13) ═══
SANDBOX_BASE_URL=http://sandbox:8090
SANDBOX_TIMEOUT_S=30
MAX_SKILL_OUTPUT_MB=20

# ═══ Upload (§15.2) ═══
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document
PRESIGN_TTL_S=300

# ═══ Vận hành ═══
LOG_LEVEL=INFO
# true mới bật /_debug/*
DEBUG=false
RAW_RESPONSE_KEEP_DAYS=30
PURGE_AFTER_DAYS=30
